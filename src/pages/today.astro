  .today-operations-ribbon :global(section), .today-operations-ribbon :global(form), .today-operations-ribbon :global(label), .today-workspace :global(section), .today-workspace :global(form), .today-workspace :global(label), .today-closeout-band :global(section), .today-closeout-band :global(form), .today-closeout-band :global(label) { min-width: 0; }
  /* prettier-ignore */
  .today-operations-ribbon :global(form), .today-workspace :global(form), .today-closeout-band :global(form) { display: grid; gap: 0.65rem; }
  /* prettier-ignore */
  .today-operations-ribbon :global(input), .today-operations-ribbon :global(select), .today-operations-ribbon :global(textarea), .today-operations-ribbon :global(button), .today-workspace :global(input), .today-workspace :global(select), .today-workspace :global(textarea), .today-workspace :global(button), .today-closeout-band :global(input), .today-closeout-band :global(select), .today-closeout-band :global(textarea), .today-closeout-band :global(button) { width: 100%; max-width: 100%; min-height: 44px; }
  /* prettier-ignore */
  .today-operations-ribbon :global(button), .today-operations-ribbon :global(.today-task-inbox__actions), .today-workspace :global(button), .today-workspace :global(.today-tasks__actions), .today-closeout-band :global(button) { flex-wrap: wrap; touch-action: manipulation; }
