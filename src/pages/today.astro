  /* prettier-ignore */
  @media (max-width: 64rem) { .today-operations-ribbon { grid-template-columns: 1fr; } .today-operations-ribbon > * + * { border-inline-start: 0; border-top: 1px solid var(--today-border); } .today-workspace { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'sheet' 'intention'; } .today-workspace__sheet > :global(.today-sheet), .today-workspace__intention > :global(.daily-header) { height: auto; max-height: none; overflow: visible; } .today-closeout-band :global(.today-closeout__form) { grid-template-columns: minmax(0, 1fr); } .today-closeout-band :global(.today-closeout__form > #closeout-help), .today-closeout-band :global(.today-closeout__form > button) { grid-column: 1; grid-row: auto; width: 100%; } }
  /* prettier-ignore */
  @media (max-width: 48rem) { .app-route--today { padding-inline-start: max(0.25rem, env(safe-area-inset-left)); padding-inline-end: max(0.25rem, env(safe-area-inset-right)); } .today-operations-ribbon, .today-closeout-band { border-radius: var(--radius, 1rem); } .today-operations-ribbon > * { padding: 1rem; } .today-operations-ribbon :global(button[type='submit']), .today-workspace :global(button[type='submit']), .today-closeout-band :global(button[type='submit']) { width: 100%; } }
  /* prettier-ignore */
  /* Approved Command Ribbon desktop proportions: the contextual band leads, the ribbon stays one surface, and the quieter workspace follows. */
  @media (min-width: 64rem) {
    .app-route--today {
      gap: 1rem;
    }
    :global(.today-active-block) {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(8.75rem, 0.26fr);
      column-gap: 1.5rem;
      align-items: start;
