{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronos.local/schemas/penpot-coverage-v2.schema.json",
  "title": "Chronos Penpot closed coverage v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "revision", "defaults", "entries"],
  "properties": {
    "$schema": { "const": "./schemas/coverage.schema.json" },
    "schemaVersion": { "const": 2 },
    "revision": { "type": "integer", "minimum": 0 },
    "defaults": { "type": "object" },
    "entries": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          { "type": "string" },
          { "enum": ["token", "grammar", "route"] },
          { "type": "string" },
          { "type": "string" },
          { "type": "array", "items": { "type": "string" } }
        ],
        "minItems": 4,
        "maxItems": 5
      }
    }
  }
}
