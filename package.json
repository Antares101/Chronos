{
  "name": "chronos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "penpot:check": "node scripts/validate-penpot-contract.mjs",
    "astro": "astro",
    "check": "astro check",
    "db:check": "drizzle-kit check --config drizzle.config.ts",
    "typecheck": "astro check",
    "lint": "eslint . --ext .js,.ts,.tsx,.astro",
    "format": "prettier --write --ignore-unknown \"*.{js,ts,cjs,json}\" \"biome.jsonc\" \"lefthook.yml\" \".github/**/*.{yml,yaml}\" \".penpot/**/*.{json,md}\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"src/**/*.{astro,ts,tsx}\" \".env.example\"",
    "format:check": "prettier --check --ignore-unknown \"*.{js,ts,cjs,json}\" \"biome.jsonc\" \"lefthook.yml\" \".github/**/*.{yml,yaml}\" \".penpot/**/*.{json,md}\" \"scripts/**/*.{js,mjs,cjs,ts}\" \"src/**/*.{astro,ts,tsx}\" \".env.example\"",
    "biome:check": "biome check --error-on-warnings .",
    "biome:ci": "biome ci --error-on-warnings .",
    "deadcode:check": "knip",
    "quality": "npm run hooks:check && npm run db:check && npm run penpot:check && npm run biome:check && npm run lint && npm run deadcode:check && npm run format:check && npm run check && npm run test && npm run build",
    "quality:ci": "npm run hooks:check && npm run db:check && npm run penpot:check && npm run biome:ci && npm run lint && npm run deadcode:check && npm run format:check && npm run check && npm run test && npm run build",
    "hooks:install": "lefthook install",
    "hooks:check": "lefthook validate",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "test": "vitest run && node --test scripts/validate-penpot-contract.test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.3",
    "@astrojs/react": "^6.0.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "astro": "^7.3.3",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.5.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "agentation": "^3.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
